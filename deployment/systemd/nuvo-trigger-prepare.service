[Unit]
Description=Provision Nuvo RP1 PIO hardware trigger
After=local-fs.target systemd-udev-settle.service
# The native daemon starts this unit synchronously from ExecStartPre. Ordering
# this unit before the daemon would make that nested start wait on its caller.
ConditionPathExists=/etc/nuvo-depth/daemon.yaml

[Service]
Type=oneshot
ExecStart=/usr/lib/nuvo-depth/nuvo-trigger-prepare /etc/nuvo-depth/daemon.yaml
TimeoutStartSec=20s
# Run again for each daemon start, including GPIO/configuration changes.
RemainAfterExit=no
