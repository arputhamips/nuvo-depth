[Unit]
Description=Nuvo Depth bounded privileged control request

[Service]
Type=oneshot
ExecStart=/usr/lib/nuvo-depth/nuvo-system-agent
StandardInput=socket
StandardOutput=journal
User=root
Group=nuvo-video
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/nuvo-depth /var/lib/nuvo-depth -/var/lib/nuvo-depth-setup /run/nuvo-depth
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
TasksMax=32
TimeoutStartSec=330s
