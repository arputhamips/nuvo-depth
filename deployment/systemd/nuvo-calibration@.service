[Unit]
Description=Nuvo Depth calibration bundle validation job %i

[Service]
Type=oneshot
User=nuvo-depth
Group=nuvo-video
ExecStart=/usr/lib/nuvo-depth/nuvo-calibration validate /var/cache/nuvo-depth/calibration-jobs/%i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/cache/nuvo-depth/calibration-jobs
MemoryMax=1G
TasksMax=32
