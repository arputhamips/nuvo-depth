{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {
      "name": "minimal-host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/minimal-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEPTHD_WITH_CONFIG": "OFF",
        "DEPTHD_WITH_OPENCV": "OFF",
        "DEPTHD_WITH_PI5_CAPTURE": "OFF",
        "DEPTHD_WITH_GATEWAY": "OFF",
        "DEPTHD_WITH_FFMPEG_ENCODER": "OFF"
      }
    },
    {
      "name": "development-full",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/development-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEPTHD_WITH_CONFIG": "ON",
        "DEPTHD_WITH_OPENCV": "ON",
        "DEPTHD_WITH_PI5_CAPTURE": "OFF",
        "DEPTHD_WITH_GATEWAY": "ON",
        "DEPTHD_WITH_FFMPEG_ENCODER": "ON",
        "DEPTHD_WITH_SYSTEMD": "OFF"
      }
    },
    {
      "name": "pi5-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pi5-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEPTHD_PRODUCTION_BUILD": "ON",
        "DEPTHD_WITH_CONFIG": "ON",
        "DEPTHD_WITH_OPENCV": "ON",
        "DEPTHD_WITH_PI5_CAPTURE": "ON",
        "DEPTHD_WITH_EGL_GL_DMABUF_RECTIFICATION": "ON",
        "DEPTHD_WITH_GATEWAY": "ON",
        "DEPTHD_WITH_FFMPEG_ENCODER": "ON",
        "DEPTHD_WITH_SYSTEMD": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    },
    {
      "name": "pi5-minimal",
      "inherits": "pi5-release",
      "binaryDir": "${sourceDir}/build/pi5-minimal",
      "cacheVariables": {
        "DEPTHD_PRODUCTION_BUILD": "OFF",
        "DEPTHD_MINIMAL_PACKAGE": "ON",
        "DEPTHD_WITH_GATEWAY": "OFF",
        "DEPTHD_WITH_FFMPEG_ENCODER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "minimal-host", "configurePreset": "minimal-host"},
    {"name": "development-full", "configurePreset": "development-full"},
    {"name": "pi5-release", "configurePreset": "pi5-release"},
    {"name": "pi5-minimal", "configurePreset": "pi5-minimal"}
  ],
  "testPresets": [
    {"name": "minimal-host", "configurePreset": "minimal-host", "output":{"outputOnFailure":true}},
    {"name": "development-full", "configurePreset": "development-full", "output":{"outputOnFailure":true}},
    {"name": "pi5-release", "configurePreset": "pi5-release", "output":{"outputOnFailure":true}},
    {"name": "pi5-minimal", "configurePreset": "pi5-minimal", "output":{"outputOnFailure":true}}
  ]
}
