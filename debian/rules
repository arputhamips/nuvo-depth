#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

ifeq ($(DEB_HOST_ARCH),arm64)
PLATFORM_FLAGS = -DDEPTHD_PRODUCTION_BUILD=ON -DDEPTHD_WITH_PI5_CAPTURE=ON -DDEPTHD_WITH_EGL_GL_DMABUF_RECTIFICATION=ON
else
PLATFORM_FLAGS = -DDEPTHD_PRODUCTION_BUILD=OFF -DDEPTHD_WITH_PI5_CAPTURE=OFF -DDEPTHD_WITH_EGL_GL_DMABUF_RECTIFICATION=OFF
endif

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=obj-$(DEB_HOST_GNU_TYPE)

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja --builddirectory=obj-$(DEB_HOST_GNU_TYPE) -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr \
		-DDEPTHD_WITH_CONFIG=ON -DDEPTHD_WITH_OPENCV=ON \
		-DDEPTHD_WITH_GATEWAY=ON -DDEPTHD_WITH_FFMPEG_ENCODER=ON \
		-DDEPTHD_WITH_SYSTEMD=ON \
		$(PLATFORM_FLAGS)

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 config/nuvo_pi5_depth_100mm.yaml debian/tmp/etc/nuvo-depth/daemon.yaml
	install -D -m 0644 config/appliance.yaml debian/tmp/etc/nuvo-depth/appliance.yaml
	install -D -m 0644 config/encoding.json debian/tmp/etc/nuvo-depth/encoding.json
	install -D -m 0644 config/stereo.json debian/tmp/etc/nuvo-depth/stereo.json
	install -D -m 0644 config/exposure.json debian/tmp/etc/nuvo-depth/exposure.json

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_missing:
	dh_missing --fail-missing
